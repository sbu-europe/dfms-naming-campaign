%% DFMS High-Level Entity Relationship Diagram
%% Shows relationships between core entities

erDiagram
    VEHICLE ||--o{ TRIP : "assigned to"
    DRIVER ||--o{ TRIP : "assigned to"
    VENDOR ||--o{ VEHICLE : "owns"
    VENDOR ||--o{ TRIP : "provides"
    
    PRODUCT ||--o{ PRODUCT_REQUISITION : "requested in"
    PRODUCT ||--o{ TRANSPORT_REQUEST : "transported in"
    
    POI ||--o{ PRODUCT_REQUISITION : "origin"
    POI ||--o{ PRODUCT_REQUISITION : "destination"
    POI ||--o{ TRANSPORT_REQUEST : "origin"
    POI ||--o{ TRANSPORT_REQUEST : "destination"
    POI ||--o{ TRIP : "origin"
    POI ||--o{ TRIP : "destination"
    
    PRODUCT_REQUISITION ||--o| TRANSPORT_REQUEST : "generates"
    TRANSPORT_REQUEST ||--o{ TRANSPORT_ORDER : "creates"
    TRANSPORT_ORDER ||--|| TRIP : "executes"
    
    TRIP ||--o| QC_INSPECTION : "requires"
    TRIP ||--o| TRIP_COST : "has"
    TRIP ||--o| INVOICE : "generates"
    
    VENDOR ||--o{ INVOICE : "receives"
    VENDOR ||--o{ VENDOR_BID : "submits"
    TRANSPORT_ORDER ||--o{ VENDOR_BID : "receives"
    
    VEHICLE {
        uuid id PK
        string registration_number
        string type
        decimal capacity
        string status
        string owner_type
        uuid vendor_id FK
    }
    
    DRIVER {
        uuid id PK
        string name
        string contact_number
        string license_number
        string status
        decimal rating
    }
    
    VENDOR {
        uuid id PK
        string name
        string contact_number
        string type
        string status
        decimal rating
    }
    
    PRODUCT {
        uuid id PK
        string name
        string code
        string category
        string unit_of_measure
    }
    
    POI {
        uuid id PK
        string name
        string address
        float latitude
        float longitude
        string type
    }
    
    PRODUCT_REQUISITION {
        uuid id PK
        string pr_number
        uuid product_id FK
        decimal quantity
        uuid origin_poi_id FK
        uuid destination_poi_id FK
        string status
        uuid tr_id FK
    }
    
    TRANSPORT_REQUEST {
        uuid id PK
        string tr_number
        uuid pr_id FK
        uuid product_id FK
        uuid origin_poi_id FK
        uuid destination_poi_id FK
        string status
    }
    
    TRANSPORT_ORDER {
        uuid id PK
        string to_number
        uuid tr_id FK
        uuid vehicle_id FK
        uuid driver_id FK
        uuid vendor_id FK
        string fleet_type
        string status
    }
    
    TRIP {
        uuid id PK
        string trip_number
        uuid to_id FK
        uuid vehicle_id FK
        uuid driver_id FK
        uuid origin_poi_id FK
        uuid destination_poi_id FK
        string status
        datetime start_time
        datetime end_time
    }
    
    QC_INSPECTION {
        uuid id PK
        uuid trip_id FK
        string inspection_type
        string status
        string result
    }
    
    TRIP_COST {
        uuid id PK
        uuid trip_id FK
        decimal total_cost
        string status
    }
    
    INVOICE {
        uuid id PK
        string invoice_number
        uuid vendor_id FK
        uuid trip_id FK
        decimal amount
        string status
    }
    
    VENDOR_BID {
        uuid id PK
        uuid to_id FK
        uuid vendor_id FK
        decimal bid_amount
        string status
    }

