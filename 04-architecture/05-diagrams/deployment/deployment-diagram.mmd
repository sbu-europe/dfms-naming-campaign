%% DFMS Deployment Diagram — Phase 1 (Current)
%% Shows actual Phase 1 infrastructure: single server, Docker Compose, Nginx
%%
%% Phase Notes:
%% - Phase 1 (current): Single EC2 instance, Docker Compose, Nginx reverse proxy, Redis broker
%% - Phase 2+: ECS/Kubernetes, ALB, Kong/AWS API Gateway, RabbitMQ/SQS, CloudFront
%% See: ADR-004 (Phase 1 Modular Monolith)

graph TB
    subgraph Internet["Internet"]
        Users["Users<br/>(Web & Mobile)"]
    end

    subgraph EC2["AWS EC2 Instance (Phase 1)"]
        subgraph DockerCompose["Docker Compose Stack"]
            Nginx["Nginx 1.25<br/>(Reverse Proxy)<br/><br/>Port 80/443<br/>Static files<br/>SSL termination"]

            APIServer["Django API Server<br/>(Django + DRF)<br/><br/>Port 8000<br/>Business logic<br/>REST APIs"]

            CeleryWorker["Celery Worker<br/><br/>Async task processing<br/>Concurrency: 4"]

            CeleryBeat["Celery Beat<br/><br/>Scheduled jobs<br/>DatabaseScheduler"]

            Redis["Redis 7<br/><br/>Celery broker (db/0)<br/>Cache (db/1)<br/>Task results (db/2)"]

            Postgres["PostgreSQL 15<br/><br/>Multi-tenant schemas<br/>django_tenants<br/>Port 5432"]

            MediaVol[("Media Volume<br/><br/>Uploaded files<br/>Photos/Videos")]

            StaticVol[("Static Volume<br/><br/>CSS/JS/Images")]
        end
    end

    subgraph External["External Services (Planned)"]
        GPS["GPS/VTS Provider<br/><br/>Vehicle Tracking API"]
        ERP["ERP System<br/><br/>Financial Sync API"]
        Maps["Maps Service<br/><br/>Route Planning API"]
        SMS["SMS Gateway<br/><br/>Notification API"]
    end

    %% User to Nginx
    Users -->|"HTTPS/HTTP"| Nginx

    %% Nginx to Django
    Nginx -->|"HTTP :8000<br/>(proxy_pass)"| APIServer
    Nginx -->|"Static files"| StaticVol
    Nginx -->|"Media files"| MediaVol

    %% Django to data stores
    APIServer -->|"SQL :5432"| Postgres
    APIServer -->|"Redis :6379"| Redis
    APIServer -->|"File I/O"| MediaVol

    %% Celery connections
    Redis -->|"Consume tasks"| CeleryWorker
    Redis -->|"Consume schedule"| CeleryBeat
    CeleryBeat -->|"Enqueue tasks"| Redis
    CeleryWorker -->|"SQL :5432"| Postgres
    CeleryWorker -->|"File I/O"| MediaVol

    %% External (not yet integrated)
    APIServer -.->|"HTTPS (planned)"| GPS
    APIServer -.->|"HTTPS (planned)"| ERP
    APIServer -.->|"HTTPS (planned)"| Maps
    CeleryWorker -.->|"HTTPS (planned)"| SMS

    classDef serverStyle fill:#232F3E,stroke:#FF9900,stroke-width:2px,color:#ffffff
    classDef appStyle fill:#1168bd,stroke:#0b4884,stroke-width:2px,color:#ffffff
    classDef dataStyle fill:#438dd5,stroke:#2e5f8d,stroke-width:2px,color:#ffffff
    classDef externalStyle fill:#999999,stroke:#666666,stroke-width:2px,color:#ffffff
    classDef storageStyle fill:#3f8624,stroke:#2d6119,stroke-width:2px,color:#ffffff

    class Nginx,APIServer,CeleryWorker,CeleryBeat appStyle
    class Redis,Postgres dataStyle
    class MediaVol,StaticVol storageStyle
    class GPS,ERP,Maps,SMS externalStyle
